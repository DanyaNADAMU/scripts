# Bash completion for scripts
_scripts_completions() {
    local cur prev commands
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    commands="update list prune clean autoupdate uninstall help"

    if [ "$COMP_CWORD" -eq 1 ]; then
        COMPREPLY=( $(compgen -W "$commands" -- "$cur") )
        return 0
    fi

    case "$prev" in
        autoupdate)
            COMPREPLY=( $(compgen -W "status enable disable" -- "$cur") )
            return 0
            ;;
        enable|disable)
            COMPREPLY=( $(compgen -W "apt" -- "$cur") )
            return 0
            ;;
        --scope)
            COMPREPLY=( $(compgen -W "user system" -- "$cur") )
            return 0
            ;;
        --category)
            COMPREPLY=( $(compgen -W "all server desktop media" -- "$cur") )
            return 0
            ;;
        --method)
            COMPREPLY=( $(compgen -W "link copy" -- "$cur") )
            return 0
            ;;
        uninstall)
            COMPREPLY=( $(compgen -W "media backup-seafile backup-seadrive keylight setup-user --scope --yes --help" -- "$cur") )
            return 0
            ;;
        prune|clean)
            COMPREPLY=( $(compgen -W "--scope --yes --help" -- "$cur") )
            return 0
            ;;
        *)
            local options="--scope --category --method --yes --help"
            COMPREPLY=( $(compgen -W "$options" -- "$cur") )
            return 0
            ;;
    esac
}
complete -F _scripts_completions scripts
