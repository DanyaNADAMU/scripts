# Bash completion for backup-seadrive
_backup_seadrive_completions() {
    local cur
    cur="${COMP_WORDS[COMP_CWORD]}"
    if [ "$COMP_CWORD" -eq 1 ]; then
        COMPREPLY=( $(compgen -W "-h --help --setup-timer --remove-timer --status --dry-run" -- "$cur") )
    fi
}
complete -F _backup_seadrive_completions backup-seadrive
