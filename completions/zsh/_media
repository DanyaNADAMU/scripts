#compdef media

_media() {
    local -a commands
    commands=(
        'init:Initialize directory structure for an asset version'
        'build:Build, sign, and render multi-scale dist assets from master'
        'audit:Run full non-blocking integrity and proof audit'
        'list:List managed assets, versions, and latest symlinks'
        'upgrade:Recursively upgrade OpenTimestamps proofs in Bitcoin'
        'sign:Sign an individual image with C2PA and invisible watermark'
        'verify:Inspect and verify C2PA, watermarks & OpenTimestamps'
        'stamp:Anchor any file in Bitcoin blockchain via OpenTimestamps'
        'timer:Manage background systemd timer for OpenTimestamps upgrades'
        'keys:Manage C2PA signing keys and Bitwarden integration'
    )

    _arguments -C \
        '1: :->command' \
        '*:: :->args'

    case $state in
        command)
            _describe -t commands 'media command' commands
            ;;
        args)
            case $words[1] in
                init)
                    _arguments \
                        '1:asset name:' \
                        '2:version tag:' \
                        '(-d --dir)'{-d,--dir}'[Base icons library directory]:icons directory:_files -/' \
                        '(-p --proofs-dir)'{-p,--proofs-dir}'[Separated proofs library directory]:proofs directory:_files -/' \
                        '(-h --help)'{-h,--help}'[Display help message]'
                    ;;
                build)
                    _arguments \
                        '1:asset name:' \
                        '2:version tag:' \
                        '(-m --master)'{-m,--master}'[Cropped square master image]:master file:_files -g "*.([pP][nN][gG]|[wW][eE][bB][pP]|[jJ][pP][gG]|[jJ][pP][eE][gG])"' \
                        '(-r --raw)'{-r,--raw}'[Raw project canvas (XCF/PSD/SVG)]:raw file:_files' \
                        '(-d --dir)'{-d,--dir}'[Base icons library directory]:icons directory:_files -/' \
                        '(-p --proofs-dir)'{-p,--proofs-dir}'[Separated proofs library directory]:proofs directory:_files -/' \
                        '--sizes[Comma-separated dist resolutions]:resolutions:' \
                        '--bw[Fetch C2PA credentials from Bitwarden into RAM]::item name:' \
                        '--bw-item[Fetch C2PA credentials from Bitwarden item into RAM]:item name:' \
                        '--no-sign[Skip C2PA showcase signing]' \
                        '--no-stamp[Skip OpenTimestamps Bitcoin anchoring]' \
                        '--force[Bypass audit mismatch and re-stamp source files]' \
                        '(-h --help)'{-h,--help}'[Display help message]'
                    ;;
                audit)
                    _arguments \
                        '1:asset name:' \
                        '2:version tag:' \
                        '(-d --dir)'{-d,--dir}'[Base icons library directory]:icons directory:_files -/' \
                        '(-p --proofs-dir)'{-p,--proofs-dir}'[Separated proofs library directory]:proofs directory:_files -/' \
                        '(-h --help)'{-h,--help}'[Display help message]'
                    ;;
                list)
                    _arguments \
                        '(-d --dir)'{-d,--dir}'[Base icons library directory]:icons directory:_files -/' \
                        '(-p --proofs-dir)'{-p,--proofs-dir}'[Separated proofs library directory]:proofs directory:_files -/' \
                        '(-h --help)'{-h,--help}'[Display help message]'
                    ;;
                upgrade)
                    _arguments \
                        '1:target (asset name, folder, or .ots file):_files' \
                        '2:version tag:' \
                        '(-d --dir)'{-d,--dir}'[Base icons library directory]:icons directory:_files -/' \
                        '(-p --proofs-dir)'{-p,--proofs-dir}'[Separated proofs library directory]:proofs directory:_files -/' \
                        '(-h --help)'{-h,--help}'[Display help message]'
                    ;;
                sign)
                    _arguments \
                        '1:input image file:_files -g "*.([pP][nN][gG]|[jJ][pP][gG]|[jJ][pP][eE][gG]|[wW][eE][bB][pP]|[aA][vV][iI][fF]|[sS][vV][gG]|[tT][iI][fF][fF])"' \
                        '(-o --output)'{-o,--output}'[Output file path]:output file:_files' \
                        '--in-place[Overwrite input file directly]' \
                        '(-t --title)'{-t,--title}'[Media title]:title:' \
                        '(-a --author)'{-a,--author}'[Author name and contact]:author:' \
                        '(-d --domain)'{-d,--domain}'[Signing domain]:domain:' \
                        '(-m --description)'{-m,--description}'[Custom action description]:description:' \
                        '(-l --license)'{-l,--license}'[License text]:license:' \
                        '(-w --watermark)'{-w,--watermark}'[Invisible watermark text]:watermark text:' \
                        '--no-watermark[Disable invisible DWT-DCT watermark]' \
                        '--no-c2pa[Disable C2PA manifest signing]' \
                        '--stamp[Anchor in Bitcoin blockchain via OpenTimestamps]' \
                        '(-s --secret)'{-s,--secret}'[Secret passphrase for watermark permutation]:passphrase:' \
                        '--key[Custom EC private key PEM file]:key file:_files' \
                        '--cert[Custom X.509 certificate chain PEM file]:cert file:_files' \
                        '--bw[Fetch credentials from Bitwarden into RAM]::item name:' \
                        '--bw-item[Fetch credentials from Bitwarden into RAM]:item name:' \
                        '(-h --help)'{-h,--help}'[Display help message]'
                    ;;
                verify)
                    _arguments \
                        '1:image file to inspect:_files -g "*.([pP][nN][gG]|[jJ][pP][gG]|[jJ][pP][eE][gG]|[wW][eE][bB][pP]|[aA][vV][iI][fF]|[sS][vV][gG]|[tT][iI][fF][fF])"' \
                        '--ots[Detached .ots proof file]:ots file:_files -g "*.ots"' \
                        '(-s --secret)'{-s,--secret}'[Secret passphrase for watermark extraction]:secret:' \
                        '--bw[Fetch watermark secret from Bitwarden into RAM]::item name:' \
                        '--bw-item[Fetch watermark secret from Bitwarden into RAM]:item name:' \
                        '--json[Output raw verification report in JSON]' \
                        '(-h --help)'{-h,--help}'[Display help message]'
                    ;;
                stamp)
                    _arguments \
                        '1:file to timestamp:_files' \
                        '(-f --force)'{-f,--force}'[Overwrite existing .ots file]' \
                        '--wait[Wait until confirmation block is available]' \
                        '(-h --help)'{-h,--help}'[Display help message]'
                    ;;
                timer)
                    local -a timer_cmds
                    timer_cmds=(
                        'setup:Install and enable systemd user timer'
                        'status:Show timer status'
                        'remove:Disable and remove timer'
                    )
                    _describe -t timer_cmds 'timer operation' timer_cmds
                    ;;
                keys)
                    local -a keys_cmds
                    keys_cmds=(
                        'show:Show active certificate details and paths'
                        'gen:Generate or regenerate C2PA signing credentials'
                        'export:Export private key and cert in PEM format'
                        'push:Push local keys to Bitwarden vault as Secure Note'
                        'use:Configure default Bitwarden item (or local for disk)'
                    )
                    _describe -t keys_cmds 'keys operation' keys_cmds
                    ;;
            esac
            ;;
    esac
}

_media "$@"
