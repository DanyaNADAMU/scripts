#compdef keylight

_keylight() {
    local -a profiles
    local -a raw_profiles
    raw_profiles=("${(@f)$(keylight --complete-zsh 2>/dev/null)}")

    if (( ${#raw_profiles[@]} > 0 )); then
        profiles=("${raw_profiles[@]}")
    else
        profiles=(
            'off:Turn off all keyboard backlight'
            'night:Forest 4-zone gradient (emerald -> olive)'
            'cyan:Static vivid cyan backlight (#00FFFF)'
            'white:Static clean soft white backlight (#FFFFFF)'
        )
    fi

    _arguments \
        '(-h --help)'{-h,--help}'[Display help message]' \
        '(-l --list)'{-l,--list}'[List available profiles]' \
        '(-c --current)'{-c,--current}'[Show currently active profile]' \
        '(-n --next)'{-n,--next}'[Switch to next profile in sequence]' \
        '1:profile:->profile' && return 0

    case "$state" in
        profile)
            _describe 'profile' profiles
            ;;
    esac
}

_keylight "$@"
