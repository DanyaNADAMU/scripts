#compdef scripts

_scripts() {
    local -a commands
    commands=(
        'update:Sync and update installed utilities from repository'
        'list:List all declared and installed scripts'
        'prune:Find and remove deprecated or orphaned utilities'
        'clean:Alias for prune'
        'autoupdate:Manage automated updates via package manager hooks'
        'uninstall:Remove installed scripts, man pages, and completions'
        'help:Show help information'
    )

    _arguments -C \
        '1: :->command' \
        '*:: :->args'

    case $state in
        command)
            _describe -t commands 'scripts command' commands
            ;;
        args)
            case $words[1] in
                sync|update|install)
                    _arguments \
                        '--scope[Target installation directory]:scope:(user system)' \
                        '--category[Filter by script category]:category:(all server desktop media)' \
                        '--method[Installation method]:method:(link copy)' \
                        '(-y --yes)'{-y,--yes}'[Run non-interactively, accepting all defaults]' \
                        '(-h --help)'{-h,--help}'[Display help message]'
                    ;;
                autoupdate)
                    _arguments \
                        '1:action:(status enable disable)' \
                        '2:target:(apt)'
                    ;;
                prune|clean)
                    _arguments \
                        '--scope[Target directory scope]:scope:(user system)' \
                        '(-y --yes)'{-y,--yes}'[Skip confirmation prompt]' \
                        '(-h --help)'{-h,--help}'[Display help message]'
                    ;;
                uninstall)
                    _arguments \
                        '--scope[Target directory scope]:scope:(user system)' \
                        '(-y --yes)'{-y,--yes}'[Skip confirmation prompt]' \
                        '(-h --help)'{-h,--help}'[Display help message]' \
                        '*:utility:(sign-image build-image media backup-seafile backup-seadrive setup-user)'
                    ;;
                list)
                    _arguments \
                        '--scope[Target directory scope]:scope:(user system)' \
                        '(-h --help)'{-h,--help}'[Display help message]'
                    ;;
            esac
            ;;
    esac
}

_scripts "$@"
