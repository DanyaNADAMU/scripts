#compdef sign-image

_sign_image() {
    local -a commands
    commands=(
        'sign:Sign an image with C2PA, watermark and OpenTimestamps'
        'verify:Inspect and verify C2PA, watermarks & OpenTimestamps'
        'stamp:Anchor or upgrade media files in Bitcoin blockchain'
        'credentials:View, export, or import signing credentials'
        'keygen:Generate or regenerate C2PA signing credentials'
    )

    _arguments -C \
        '1: :->command' \
        '*:: :->args'

    case $state in
        command)
            _describe -t commands 'sign-image command' commands
            ;;
        args)
            case $words[1] in
                sign)
                    _arguments \
                        '(-o --output)'{-o,--output}'[Destination path]:output file:_files' \
                        '--in-place[Overwrite input file directly]' \
                        '(-t --title)'{-t,--title}'[Media title]:title:' \
                        '(-a --author)'{-a,--author}'[Author name and contact]:author:' \
                        '(-d --domain)'{-d,--domain}'[Signing domain]:domain:' \
                        '(-m --description)'{-m,--description}'[Custom action description]:desc:' \
                        '(-l --license)'{-l,--license}'[License or copyright notice]:license:' \
                        '(-w --watermark)'{-w,--watermark}'[Custom watermark text]:text:' \
                        '--no-watermark[Disable invisible DWT-DCT watermark]' \
                        '--no-c2pa[Disable C2PA manifest signing]' \
                        '--stamp[Anchor signed file in Bitcoin blockchain via OpenTimestamps]' \
                        '(-s --secret)'{-s,--secret}'[Secret passphrase for watermark permutation]:passphrase:' \
                        '--key[Custom EC private key PEM]:key file:_files' \
                        '--cert[Custom X.509 certificate chain PEM]:cert file:_files' \
                        '(-h --help)'{-h,--help}'[Display help message]' \
                        '*:media file:_files -g "*.([pP][nN][gG]|[jJ][pP][gG]|[jJ][pP][eE][gG]|[wW][eE][bB][pP]|[aA][vV][iI][fF]|[sS][vV][gG]|[tT][iI][fF][fF])"'
                    ;;
                verify)
                    _arguments \
                        '(-s --secret)'{-s,--secret}'[Secret passphrase for watermark extraction]:passphrase:' \
                        '--ots[Explicit OpenTimestamps proof file]:ots file:_files -g "*.ots"' \
                        '--json[Output raw verification report in JSON]' \
                        '(-h --help)'{-h,--help}'[Display help message]' \
                        '*:target media:_files'
                    ;;
                stamp)
                    _arguments \
                        '--upgrade[Upgrade pending .ots proof against Bitcoin calendars]' \
                        '--wait[Wait until confirmation block is available]' \
                        '(-f --force)'{-f,--force}'[Overwrite existing .ots file]' \
                        '(-h --help)'{-h,--help}'[Display help message]' \
                        '*:file to stamp:_files'
                    ;;
                credentials)
                    _arguments \
                        '--export[Export raw private key and certificate chain for Bitwarden backup]' \
                        '--import-key[Import private key PEM file]:key file:_files' \
                        '--import-cert[Import certificate chain PEM file]:cert file:_files' \
                        '(-h --help)'{-h,--help}'[Display help message]'
                    ;;
                keygen)
                    _arguments \
                        '(-d --domain)'{-d,--domain}'[Domain name for certificates]:domain:' \
                        '--out-dir[Destination directory for credentials]:directory:_files -/' \
                        '(-h --help)'{-h,--help}'[Display help message]'
                    ;;
            esac
            ;;
    esac
}

_sign_image "$@"
