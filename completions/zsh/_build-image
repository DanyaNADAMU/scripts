#compdef build-image

_build_image() {
    local -a commands
    commands=(
        'build:Build, sign, and render multi-scale dist assets from master'
        'audit:Run full non-blocking integrity and proof audit'
        'upgrade:Recursively upgrade OpenTimestamps proofs in asset tree'
        'list:List managed assets, versions, and latest symlinks'
    )

    _arguments -C \
        '1: :->command' \
        '*:: :->args'

    case $state in
        command)
            _describe -t commands 'build-image command' commands
            ;;
        args)
            case $words[1] in
                build)
                    _arguments \
                        '1:asset name:' \
                        '2:version tag:' \
                        '(-m --master)'{-m,--master}'[Cropped square master image]:master file:_files -g "*.([pP][nN][gG]|[wW][eE][bB][pP]|[jJ][pP][gG]|[jJ][pP][eE][gG])"' \
                        '(-r --raw)'{-r,--raw}'[Raw project canvas (XCF/PSD/SVG)]:raw file:_files' \
                        '(-d --dir)'{-d,--dir}'[Base icons library directory]:icons directory:_files -/' \
                        '--sizes[Comma-separated dist resolutions]:resolutions:' \
                        '--bw[Fetch C2PA credentials from Bitwarden into RAM]::item name:' \
                        '--bw-item[Fetch C2PA credentials from Bitwarden item into RAM]:item name:' \
                        '--no-sign[Skip C2PA showcase signing]' \
                        '--no-stamp[Skip OpenTimestamps Bitcoin anchoring]' \
                        '--force-re-stamp[Bypass audit mismatch and re-stamp source files]' \
                        '(-h --help)'{-h,--help}'[Display help message]'
                    ;;
                audit)
                    _arguments \
                        '1:asset name:' \
                        '2:version tag:' \
                        '(-d --dir)'{-d,--dir}'[Base icons library directory]:icons directory:_files -/' \
                        '(-h --help)'{-h,--help}'[Display help message]'
                    ;;
                upgrade)
                    _arguments \
                        '1:asset name:' \
                        '2:version tag:' \
                        '(-d --dir)'{-d,--dir}'[Base icons library directory]:icons directory:_files -/' \
                        '(-h --help)'{-h,--help}'[Display help message]'
                    ;;
                list)
                    _arguments \
                        '(-d --dir)'{-d,--dir}'[Base icons library directory]:icons directory:_files -/' \
                        '(-h --help)'{-h,--help}'[Display help message]'
                    ;;
            esac
            ;;
    esac
}

_build_image "$@"
