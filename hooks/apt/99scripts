// =============================================================================
// APT Hook: 99scripts
// Description: Background update hook for nada.mu personal utilities.
// Triggers on: 'apt update' (rate-limited to 24h, non-blocking & silent).
// =============================================================================
APT::Update::Post-Invoke { "if [ -x /usr/local/bin/scripts ]; then ( /usr/local/bin/scripts autoupdate apt >/dev/null 2>&1 & ); fi"; };
