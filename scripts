#!/usr/bin/env bash
# ==============================================================================
# Script:      scripts
# Category:    manager
# Description: Unified manager for the nada.mu personal utilities ecosystem.
# Target:      Linux / macOS
# Usage:       scripts [command] [options]
# ==============================================================================
set -euo pipefail

GITHUB_RAW="https://raw.githubusercontent.com/DanyaNADAMU/scripts/main"
COMMIT_SHA="$(curl -fsSL "https://api.github.com/repos/DanyaNADAMU/scripts/commits/main" 2>/dev/null | grep '"sha"' | head -n 1 | cut -d'"' -f4 || echo "")"
if [ -n "$COMMIT_SHA" ]; then
    GITHUB_RAW="https://raw.githubusercontent.com/DanyaNADAMU/scripts/$COMMIT_SHA"
fi
VERSION="1.0.0"


# Determine execution context (local repository vs remote/standalone)
SELF_PATH="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || realpath "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
REPO_DIR="$(cd "$(dirname "$SELF_PATH")" 2>/dev/null && pwd || echo "")"

if [ -n "$REPO_DIR" ] && [ -f "$REPO_DIR/manifest.txt" ]; then
    IS_LOCAL_REPO=true
else
    IS_LOCAL_REPO=false
    REPO_DIR=""
fi

# ------------------------------------------------------------------------------
# Helpers: I/O and Paths
# ------------------------------------------------------------------------------
log_info()  { echo -e "  \033[1;34m[i]\033[0m $*"; }
log_ok()    { echo -e "  \033[1;32m[✓]\033[0m $*"; }
log_warn()  { echo -e "  \033[1;33m[!]\033[0m $*"; }
log_err()   { echo -e "  \033[1;31m[✗]\033[0m $*" >&2; }
log_head()  { echo -e "\n\033[1;36m==>\033[0m \033[1m$*\033[0m"; }

read_input() {
    local prompt="$1"
    local default="$2"
    local var_name="$3"
    local reply=""

    if [ -t 0 ]; then
        read -r -p "$prompt [$default]: " reply || true
    elif [ -c /dev/tty ]; then
        read -r -p "$prompt [$default]: " reply < /dev/tty 2>/dev/tty || true
    else
        reply=""
    fi
    reply="${reply:-$default}"
    eval "$var_name=\"$reply\""
}

get_sha256() {
    local file="$1"
    if [ -f "$file" ]; then
        sha256sum "$file" 2>/dev/null | awk '{print $1}' || echo ""
    else
        echo ""
    fi
}

# ------------------------------------------------------------------------------
# Dependency Checking & Auto-Installation
# ------------------------------------------------------------------------------
check_dependencies() {
    local cat="$1"
    local auto_yes="$2"
    local scope="${3:-user}"

    if [ "$cat" = "all" ] || [ "$cat" = "media" ]; then
        # Check standard PATH first
        if ! command -v uv &>/dev/null; then
            # If uv exists in user's local bin, utilize it
            if [ -x "$HOME/.local/bin/uv" ]; then
                export PATH="$HOME/.local/bin:$PATH"
                if [ "$scope" = "system" ] || [ "$EUID" -eq 0 ]; then
                    mkdir -p /usr/local/bin
                    cp -f "$HOME/.local/bin/uv" /usr/local/bin/uv 2>/dev/null || true
                    cp -f "$HOME/.local/bin/uvx" /usr/local/bin/uvx 2>/dev/null || true
                    chmod 755 /usr/local/bin/uv /usr/local/bin/uvx 2>/dev/null || true
                fi
            fi
        fi

        if ! command -v uv &>/dev/null; then
            log_info "Dependency 'uv' is missing (required for Python utilities). Installing automatically..."
            local target_dir="$HOME/.local/bin"
            if [ "$scope" = "system" ] || [ "$EUID" -eq 0 ]; then
                target_dir="/usr/local/bin"
            fi
            if curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR="$target_dir" sh; then
                export PATH="$target_dir:$PATH"
                if command -v uv &>/dev/null; then
                    log_ok "'uv' installed successfully into $target_dir."
                fi
            else
                log_warn "uv auto-install failed. Media tool (media) may require uv to run."
            fi
        else
            log_ok "Dependency check: 'uv' is available."
        fi
    fi
}


# ------------------------------------------------------------------------------
# Scope & Path Configuration
# ------------------------------------------------------------------------------
set_scope_paths() {
    local scope="$1"
    if [ "$scope" = "system" ]; then
        BIN_DIR="/usr/local/bin"
        MAN_DIR="/usr/local/share/man/man1"
        BASH_COMP_DIR="/usr/share/bash-completion/completions"
        ZSH_COMP_DIR="/usr/local/share/zsh/site-functions"
        STATE_DIR="/var/lib/scripts"
        NEED_SUDO=true
    else
        local target_home="$HOME"
        if [ -n "${SUDO_USER:-}" ] && [ "$EUID" -eq 0 ]; then
            target_home="$(getent passwd "$SUDO_USER" 2>/dev/null | cut -d: -f6 || echo "$HOME")"
        fi
        BIN_DIR="${target_home}/.local/bin"
        MAN_DIR="${target_home}/.local/share/man/man1"
        BASH_COMP_DIR="${target_home}/.local/share/bash-completion/completions"
        ZSH_COMP_DIR="${target_home}/.local/share/zsh/site-functions"
        STATE_DIR="${target_home}/.local/state/scripts"
        NEED_SUDO=false
    fi
}

detect_and_resolve_scope() {
    local requested_scope="$1"
    local auto_yes="$2"

    if [ -n "$requested_scope" ]; then
        echo "$requested_scope"
        return 0
    fi

    # Determine real user home directory even if running with sudo
    local effective_user_home="$HOME"
    if [ -n "${SUDO_USER:-}" ] && [ "$EUID" -eq 0 ]; then
        effective_user_home="$(getent passwd "$SUDO_USER" 2>/dev/null | cut -d: -f6 || echo "$HOME")"
    fi

    local has_sys=false
    local has_usr=false

    if [ -f "/usr/local/bin/scripts" ] || [ -f "/var/lib/scripts/manifest.txt" ]; then
        has_sys=true
    fi

    if [ -f "$effective_user_home/.local/bin/scripts" ] || [ -f "$effective_user_home/.local/state/scripts/manifest.txt" ]; then
        has_usr=true
    fi

    # Mismatch resolution
    if [ "$has_sys" = true ] && [ "$has_usr" = false ]; then
        # Existing installation is System
        if [ "$EUID" -ne 0 ]; then
            # Mismatch: System install exists, but running without root
            if [ "$auto_yes" = true ] || ([ ! -t 0 ] && [ ! -c /dev/tty ]); then
                log_err "Existing system installation detected in /usr/local/bin, but running without root privileges." >&2
                log_info "Please run with sudo: 'sudo scripts sync', or specify '--scope user'." >&2
                return 1
            fi

            log_warn "Existing system installation detected in /usr/local/bin, but running without root privileges." >&2
            echo -e "  \033[1m[1]\033[0m Escalate with sudo to update system installation (/usr/local/bin) [default]" >&2
            echo -e "  \033[1m[2]\033[0m Install local copy in user profile ($effective_user_home/.local/bin)" >&2
            echo -e "  \033[1m[3]\033[0m Cancel" >&2
            local choice="1"
            read_input "Select action" "1" choice
            case "$choice" in
                1)
                    sudo -v >&2 || { log_err "Sudo authentication failed." >&2; return 1; }
                    echo "system"
                    return 0
                    ;;
                2)
                    echo "user"
                    return 0
                    ;;
                *)
                    echo "Aborted." >&2
                    return 2
                    ;;
            esac
        else
            echo "system"
            return 0
        fi
    elif [ "$has_usr" = true ] && [ "$has_sys" = false ]; then
        # Existing installation is User
        if [ "$EUID" -eq 0 ]; then
            # Mismatch: User install exists, but running with root/sudo
            if [ "$auto_yes" = true ] || ([ ! -t 0 ] && [ ! -c /dev/tty ]); then
                echo "user"
                return 0
            fi

            log_warn "Existing user installation detected in $effective_user_home/.local/bin, but running with root privileges." >&2
            echo -e "  \033[1m[1]\033[0m Update user installation in $effective_user_home/.local/bin [default]" >&2
            echo -e "  \033[1m[2]\033[0m Install new system-wide copy in /usr/local/bin" >&2
            echo -e "  \033[1m[3]\033[0m Cancel" >&2
            local choice="1"
            read_input "Select action" "1" choice
            case "$choice" in
                1)
                    echo "user"
                    return 0
                    ;;
                2)
                    echo "system"
                    return 0
                    ;;
                *)
                    echo "Aborted." >&2
                    return 2
                    ;;
            esac
        else
            echo "user"
            return 0
        fi
    else
        # Neither exists, or both exist: default based on EUID
        if [ "$EUID" -eq 0 ]; then
            echo "system"
        else
            echo "user"
        fi
        return 0
    fi
}

ensure_write_access() {
    local dir="$1"
    if [ ! -d "$dir" ]; then
        if [ "$NEED_SUDO" = true ] && [ "$EUID" -ne 0 ]; then
            sudo mkdir -p "$dir"
        else
            mkdir -p "$dir"
        fi
    fi
}

safe_copy_or_link() {
    local src="$1"
    local dst="$2"
    local mode="$3" # "link" or "copy"
    local as_root="${4:-false}"

    local cmd_prefix=""
    if [ "$as_root" = true ] && [ "$EUID" -ne 0 ]; then
        cmd_prefix="sudo"
    fi

    if [ "$mode" = "link" ]; then
        $cmd_prefix ln -sf "$src" "$dst"
    else
        $cmd_prefix cp --remove-destination -f "$src" "$dst" 2>/dev/null || $cmd_prefix cp -f "$src" "$dst"
    fi
    $cmd_prefix chmod 755 "$dst" 2>/dev/null || true

}

fetch_file() {
    local rel_path="$1"
    local dest_file="$2"

    if [ "$IS_LOCAL_REPO" = true ]; then
        cp -f "$REPO_DIR/$rel_path" "$dest_file"
    else
        curl -fsSL "$GITHUB_RAW/$rel_path" -o "$dest_file"
    fi
}

install_asset() {
    local rel_src="$1"
    local target_file="$2"
    local perm="${3:-644}"

    local cmd_prefix=""
    if [ "$NEED_SUDO" = true ] && [ "$EUID" -ne 0 ]; then
        cmd_prefix="sudo"
    fi

    if [ "$IS_LOCAL_REPO" = true ]; then
        if [ -f "$REPO_DIR/$rel_src" ]; then
            $cmd_prefix cp -f "$REPO_DIR/$rel_src" "$target_file"
            $cmd_prefix chmod "$perm" "$target_file" 2>/dev/null || true
        fi
    else
        local tmp_f
        tmp_f="$(mktemp)"
        if curl -fsSL "$GITHUB_RAW/$rel_src" -o "$tmp_f" 2>/dev/null && [ -s "$tmp_f" ]; then
            $cmd_prefix cp -f "$tmp_f" "$target_file"
            $cmd_prefix chmod "$perm" "$target_file" 2>/dev/null || true
        fi
        rm -f "$tmp_f"
    fi
}

install_man_and_completions() {
    local name="$1"
    install_asset "docs/man/man1/${name}.1" "$MAN_DIR/${name}.1" "644"
    install_asset "completions/bash/${name}" "$BASH_COMP_DIR/${name}" "644"
    install_asset "completions/zsh/_${name}" "$ZSH_COMP_DIR/_${name}" "644"
}

uninstall_man_and_completions() {
    local name="$1"
    local cmd_prefix=""
    if [ "$NEED_SUDO" = true ] && [ "$EUID" -ne 0 ]; then
        cmd_prefix="sudo"
    fi
    $cmd_prefix rm -f "$MAN_DIR/${name}.1" "$BASH_COMP_DIR/${name}" "$ZSH_COMP_DIR/_${name}"
}

install_apt_hook() {
    if [ -d "/etc/apt/apt.conf.d" ]; then
        local target="/etc/apt/apt.conf.d/99scripts"
        local cmd_prefix=""
        if [ "$EUID" -ne 0 ]; then
            cmd_prefix="sudo"
        fi
        if [ "$IS_LOCAL_REPO" = true ] && [ -f "$REPO_DIR/hooks/apt/99scripts" ]; then
            $cmd_prefix cp -f "$REPO_DIR/hooks/apt/99scripts" "$target"
        else
            local tmp_hook
            tmp_hook="$(mktemp)"
            if curl -fsSL "$GITHUB_RAW/hooks/apt/99scripts" -o "$tmp_hook" 2>/dev/null && [ -s "$tmp_hook" ]; then
                $cmd_prefix cp -f "$tmp_hook" "$target"
            else
                $cmd_prefix tee "$target" >/dev/null << 'EOF'
// Automated update hook for nada.mu personal utilities
APT::Update::Post-Invoke { "if [ -x /usr/local/bin/scripts ]; then /usr/local/bin/scripts autoupdate apt || true; fi"; };
DPkg::Post-Invoke { "if [ -x /usr/local/bin/scripts ]; then /usr/local/bin/scripts autoupdate apt || true; fi"; };
EOF
            fi
            rm -f "$tmp_hook"
        fi
        $cmd_prefix chmod 644 "$target" 2>/dev/null || true
    fi
}

uninstall_apt_hook() {
    if [ -f "/etc/apt/apt.conf.d/99scripts" ]; then
        local cmd_prefix=""
        if [ "$EUID" -ne 0 ]; then
            cmd_prefix="sudo"
        fi
        $cmd_prefix rm -f "/etc/apt/apt.conf.d/99scripts"
    fi
}

load_manifest() {
    local tmp_manifest="$1"
    if [ "$IS_LOCAL_REPO" = true ]; then
        cp -f "$REPO_DIR/manifest.txt" "$tmp_manifest"
    else
        if ! curl -fsSL "$GITHUB_RAW/manifest.txt" -o "$tmp_manifest"; then
            log_err "Failed to download manifest.txt from upstream repository."
            exit 1
        fi
    fi
}

# ------------------------------------------------------------------------------
# Subcommand: list
# ------------------------------------------------------------------------------
cmd_list() {
    local explicit_scope=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --scope) explicit_scope="$2"; shift 2 ;;
            *) shift ;;
        esac
    done

    local scope=""
    if [ -n "$explicit_scope" ]; then
        scope="$explicit_scope"
    elif [ -f "/usr/local/bin/scripts" ] || [ -f "/var/lib/scripts/manifest.txt" ]; then
        scope="system"
    else
        scope="user"
    fi
    set_scope_paths "$scope"

    local tmp_m
    tmp_m="$(mktemp)"
    load_manifest "$tmp_m"

    log_head "Available and Installed Scripts (Scope: $scope -> $BIN_DIR)"
    printf "  %-16s %-10s %-12s %s\n" "COMMAND" "CATEGORY" "STATUS" "DESCRIPTION"
    printf "  %-16s %-10s %-12s %s\n" "-------" "--------" "------" "-----------"

    while IFS=: read -r src_path cmd_name category desc || [ -n "$src_path" ]; do
        [[ "$src_path" =~ ^#.*$ ]] && continue
        [ -z "$src_path" ] && continue

        local status="Available"
        if [ -f "$BIN_DIR/$cmd_name" ]; then
            if [ -L "$BIN_DIR/$cmd_name" ]; then
                status="Linked"
            else
                status="Installed"
            fi
        fi

        printf "  \033[1m%-16s\033[0m %-10s %-12s %s\n" "$cmd_name" "$category" "$status" "$desc"
    done < "$tmp_m"

    rm -f "$tmp_m"
    echo ""
}

# ------------------------------------------------------------------------------
# Subcommand: sync (aliases: update, install)
# ------------------------------------------------------------------------------
cmd_sync() {
    local explicit_scope=""
    local scope=""
    local category="all"
    local auto_yes=false
    local method=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --scope) explicit_scope="$2"; shift 2 ;;
            --category) category="$2"; shift 2 ;;
            -y|--yes) auto_yes=true; shift ;;
            --update) shift ;;
            --method) method="$2"; shift 2 ;;
            *) shift ;;
        esac
    done

    local scope_status=0
    scope="$(detect_and_resolve_scope "$explicit_scope" "$auto_yes")" || scope_status=$?
    if [ $scope_status -ne 0 ]; then
        if [ $scope_status -eq 2 ]; then
            exit 0
        else
            exit 1
        fi
    fi

    if [ -z "$method" ]; then
        if [ "$IS_LOCAL_REPO" = true ]; then
            method="link"
        else
            method="copy"
        fi
    fi

    check_dependencies "$category" "$auto_yes" "$scope"

    set_scope_paths "$scope"

    if [ "$NEED_SUDO" = true ] && [ "$EUID" -ne 0 ]; then
        log_info "System scope requested. Sudo privileges will be used."
        sudo -v || { log_err "Sudo authorization failed."; exit 1; }
    fi

    ensure_write_access "$BIN_DIR"
    ensure_write_access "$MAN_DIR"
    ensure_write_access "$BASH_COMP_DIR"
    ensure_write_access "$ZSH_COMP_DIR"
    ensure_write_access "$STATE_DIR"

    local current_manifest
    current_manifest="$(mktemp)"
    load_manifest "$current_manifest"

    local prev_manifest="$STATE_DIR/manifest.txt"
    if [ "$NEED_SUDO" = true ] && [ "$EUID" -ne 0 ]; then
        sudo touch "$prev_manifest"
    else
        touch "$prev_manifest"
    fi

    log_head "Synchronizing utilities in $BIN_DIR (Category: $category, Scope: $scope)..."
    printf "  \033[1m%-16s %-10s %-12s %s\033[0m\n" "COMMAND" "CATEGORY" "STATUS" "DESCRIPTION"
    printf "  %-16s %-10s %-12s %s\n" "-------" "--------" "------" "-----------"

    local count_installed=0
    local count_updated=0
    local count_unchanged=0

    while IFS=: read -r src_path cmd_name script_cat desc || [ -n "$src_path" ]; do
        [[ "$src_path" =~ ^#.*$ ]] && continue
        [ -z "$src_path" ] && continue

        if [ "$category" != "all" ] && [ "$category" != "$script_cat" ]; then
            continue
        fi

        local target_bin="$BIN_DIR/$cmd_name"
        local old_sha
        old_sha="$(get_sha256 "$target_bin")"

        # Install script
        if [ "$IS_LOCAL_REPO" = true ]; then
            safe_copy_or_link "$REPO_DIR/$src_path" "$target_bin" "$method" "$NEED_SUDO"
        else
            local tmp_dl
            tmp_dl="$(mktemp)"
            fetch_file "$src_path" "$tmp_dl"
            if [ "$NEED_SUDO" = true ] && [ "$EUID" -ne 0 ]; then
                sudo cp --remove-destination -f "$tmp_dl" "$target_bin" 2>/dev/null || sudo cp -f "$tmp_dl" "$target_bin"
                sudo chmod 755 "$target_bin"
            else
                cp --remove-destination -f "$tmp_dl" "$target_bin" 2>/dev/null || cp -f "$tmp_dl" "$target_bin"
                chmod 755 "$target_bin"
            fi
            rm -f "$tmp_dl"
        fi

        local new_sha
        new_sha="$(get_sha256 "$target_bin")"
        local item_status="Up to date"

        if [ -z "$old_sha" ]; then
            item_status="Installed"
            count_installed=$((count_installed + 1))
        elif [ "$old_sha" != "$new_sha" ]; then
            item_status="Updated"
            count_updated=$((count_updated + 1))
        else
            count_unchanged=$((count_unchanged + 1))
        fi

        printf "  \033[1m%-16s\033[0m %-10s %-12s %s\n" "$cmd_name" "$script_cat" "$item_status" "$desc"

        # Install Man Page & Shell Completions
        install_man_and_completions "$cmd_name"
    done < "$current_manifest"

    # Install the 'scripts' manager itself into the target bin directory
    local scripts_bin="$BIN_DIR/scripts"
    local old_scripts_sha
    old_scripts_sha="$(get_sha256 "$scripts_bin")"

    if [ "$IS_LOCAL_REPO" = true ]; then
        safe_copy_or_link "$SELF_PATH" "$scripts_bin" "$method" "$NEED_SUDO"
    else
        local tmp_self
        tmp_self="$(mktemp)"
        fetch_file "scripts" "$tmp_self"
        local tmp_dest="${scripts_bin}.tmp.$$"
        if [ "$NEED_SUDO" = true ] && [ "$EUID" -ne 0 ]; then
            sudo cp -f "$tmp_self" "$tmp_dest"
            sudo chmod 755 "$tmp_dest"
            sudo mv -f "$tmp_dest" "$scripts_bin"
        else
            cp -f "$tmp_self" "$tmp_dest"
            chmod 755 "$tmp_dest"
            mv -f "$tmp_dest" "$scripts_bin"
        fi
        rm -f "$tmp_self"
    fi
    install_man_and_completions "scripts"

    local new_scripts_sha
    new_scripts_sha="$(get_sha256 "$scripts_bin")"
    local scripts_status="Up to date"
    if [ -z "$old_scripts_sha" ]; then
        scripts_status="Installed"
        count_installed=$((count_installed + 1))
    elif [ "$old_scripts_sha" != "$new_scripts_sha" ]; then
        scripts_status="Updated"
        count_updated=$((count_updated + 1))
    else
        count_unchanged=$((count_unchanged + 1))
    fi
    printf "  \033[1m%-16s\033[0m %-10s %-12s %s\n" "scripts" "manager" "$scripts_status" "Unified manager for the nada.mu personal utilities ecosystem"

    # Check for Orphaned/Deprecated scripts
    if [ -f "$prev_manifest" ]; then
        while IFS=: read -r p_src p_cmd p_cat p_desc || [ -n "$p_src" ]; do
            [[ "$p_src" =~ ^#.*$ ]] && continue
            [ -z "$p_src" ] && continue

            if ! grep -q ":$p_cmd:" "$current_manifest"; then
                if [ -f "$BIN_DIR/$p_cmd" ]; then
                    log_warn "Deprecated utility detected: '$p_cmd' (removed from upstream repository)."
                    local del_reply="y"
                    if [ "$auto_yes" = false ]; then
                        read_input "Remove $BIN_DIR/$p_cmd? (y/n)" "y" del_reply
                    fi
                    if [[ "$del_reply" =~ ^[Yy]$ ]]; then
                        if [ "$NEED_SUDO" = true ] && [ "$EUID" -ne 0 ]; then
                            sudo rm -f "$BIN_DIR/$p_cmd"
                        else
                            rm -f "$BIN_DIR/$p_cmd"
                        fi
                        uninstall_man_and_completions "$p_cmd"
                        log_ok "Removed deprecated: $p_cmd"
                    fi
                fi
            fi
        done < "$prev_manifest"
    fi

    # Fix ownership if running under sudo for user scope
    if [ "$scope" = "user" ] && [ -n "${SUDO_USER:-}" ] && [ "$EUID" -eq 0 ]; then
        local user_grp
        user_grp="$(id -gn "$SUDO_USER" 2>/dev/null || echo "$SUDO_USER")"
        chown -R "$SUDO_USER:$user_grp" "$BIN_DIR" "$STATE_DIR" "${MAN_DIR%/*}" "${BASH_COMP_DIR%/*}" "${ZSH_COMP_DIR%/*}" 2>/dev/null || true
    fi

    # Save state manifest
    if [ "$NEED_SUDO" = true ] && [ "$EUID" -ne 0 ]; then
        sudo cp -f "$current_manifest" "$prev_manifest"
    else
        cp -f "$current_manifest" "$prev_manifest"
    fi
    rm -f "$current_manifest"

    # Install APT hook if system scope and APT is present
    if [ "$scope" = "system" ] && [ -d "/etc/apt/apt.conf.d" ]; then
        install_apt_hook
    fi

    log_head "Summary"
    echo "  Installed: $count_installed | Updated: $count_updated | Up to date: $count_unchanged"
    echo "  Binary Path: $BIN_DIR"

    if [[ ":$PATH:" != *":$BIN_DIR:"* ]]; then
        log_warn "$BIN_DIR is NOT currently in your PATH environment variable."
        echo "  Add it to your shell profile (~/.zshrc or ~/.bashrc):"
        echo "    export PATH=\"$BIN_DIR:\$PATH\""
    else
        log_ok "PATH check passed ($BIN_DIR is active)."
    fi

    if [ "$scope" = "system" ] && [ -f "/etc/apt/apt.conf.d/99scripts" ]; then
        log_ok "APT hook: Auto-update enabled (/etc/apt/apt.conf.d/99scripts)."
    fi

    if [ "$scope" = "user" ]; then
        echo "  [i] Note for Zsh completions in User scope: ensure $ZSH_COMP_DIR is in fpath in ~/.zshrc:"
        echo "      fpath=($ZSH_COMP_DIR \$fpath)"
    fi
    echo "  [i] All utilities synchronized. For category filtering, use: scripts update --category <server|desktop|media>"
    echo ""
}

cmd_install() { cmd_sync "$@"; }
cmd_update()  { cmd_sync "$@"; }

# ------------------------------------------------------------------------------
# Subcommand: uninstall
# ------------------------------------------------------------------------------
cmd_uninstall() {
    local explicit_scope=""
    local auto_yes=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --scope) explicit_scope="$2"; shift 2 ;;
            -y|--yes) auto_yes=true; shift ;;
            *) shift ;;
        esac
    done

    local scope=""
    if [ -n "$explicit_scope" ]; then
        scope="$explicit_scope"
    elif [ -f "/usr/local/bin/scripts" ] || [ -f "/var/lib/scripts/manifest.txt" ]; then
        scope="system"
    else
        scope="user"
    fi

    set_scope_paths "$scope"
    local manifest_file="$STATE_DIR/manifest.txt"

    if [ "$auto_yes" = false ]; then
        local confirm=""
        read_input "Are you sure you want to uninstall all scripts from $BIN_DIR? (y/n)" "n" confirm
        if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
            echo "Aborted."
            exit 0
        fi
    fi

    if [ "$NEED_SUDO" = true ] && [ "$EUID" -ne 0 ]; then
        sudo -v
    fi

    log_head "Uninstalling utilities from $BIN_DIR..."

    if [ -f "$manifest_file" ]; then
        while IFS=: read -r src_path cmd_name cat desc || [ -n "$src_path" ]; do
            [[ "$src_path" =~ ^#.*$ ]] && continue
            [ -z "$src_path" ] && continue

            if [ "$NEED_SUDO" = true ] && [ "$EUID" -ne 0 ]; then
                sudo rm -f "$BIN_DIR/$cmd_name"
            else
                rm -f "$BIN_DIR/$cmd_name"
            fi
            uninstall_man_and_completions "$cmd_name"
            log_ok "Removed: $cmd_name"
        done < "$manifest_file"

        if [ "$NEED_SUDO" = true ] && [ "$EUID" -ne 0 ]; then
            sudo rm -rf "$STATE_DIR" "$BIN_DIR/scripts"
        else
            rm -rf "$STATE_DIR" "$BIN_DIR/scripts"
        fi
        uninstall_man_and_completions "scripts"
    else
        if [ "$NEED_SUDO" = true ] && [ "$EUID" -ne 0 ]; then
            sudo rm -f "$BIN_DIR/setup-user" "$BIN_DIR/media" "$BIN_DIR/backup-seafile" "$BIN_DIR/backup-seadrive" "$BIN_DIR/scripts"
        else
            rm -f "$BIN_DIR/setup-user" "$BIN_DIR/media" "$BIN_DIR/backup-seafile" "$BIN_DIR/backup-seadrive" "$BIN_DIR/scripts"
        fi
        uninstall_man_and_completions "backup-seafile"
        uninstall_man_and_completions "backup-seadrive"
        uninstall_man_and_completions "setup-user"
        uninstall_man_and_completions "media"
        uninstall_man_and_completions "scripts"
    fi

    if [ "$scope" = "system" ]; then
        uninstall_apt_hook
        log_ok "Removed APT auto-update hook (/etc/apt/apt.conf.d/99scripts)"
    fi

    log_ok "Uninstallation complete."
}

# ------------------------------------------------------------------------------
# Subcommand: autoupdate
# ------------------------------------------------------------------------------
cmd_autoupdate() {
    local subcmd="${1:-status}"
    shift || true

    case "$subcmd" in
        apt)
            # Internal hook invoked by APT Post-Invoke
            local stamp_file="/var/lib/scripts/last_apt_update"
            local now
            now="$(date +%s)"
            if [ -f "$stamp_file" ]; then
                local last
                last="$(stat -c %Y "$stamp_file" 2>/dev/null || echo 0)"
                if [ $((now - last)) -lt 300 ]; then
                    exit 0
                fi
            fi

            mkdir -p "/var/lib/scripts" 2>/dev/null || true
            touch "$stamp_file" 2>/dev/null || true

            log_head "Triggering automatic update of nada.mu scripts (APT hook)..."
            cmd_sync --scope system -y
            ;;
        status)
            log_head "Automatic Update Status"
            if [ -f "/etc/apt/apt.conf.d/99scripts" ]; then
                log_ok "APT hook: Enabled (/etc/apt/apt.conf.d/99scripts)"
                echo "      Triggers automatically on 'apt update' and 'apt upgrade' (rate-limit: 5m)"
            elif [ -d "/etc/apt/apt.conf.d" ]; then
                log_info "APT hook: Disabled (/etc/apt/apt.conf.d exists)"
                echo "      Enable with: sudo scripts autoupdate enable apt"
            else
                log_info "APT hook: Not available (APT package manager not detected)"
            fi
            echo ""
            ;;
        enable)
            local target="${1:-apt}"
            case "$target" in
                apt)
                    if [ ! -d "/etc/apt/apt.conf.d" ]; then
                        log_err "/etc/apt/apt.conf.d does not exist on this system."
                        exit 1
                    fi
                    if [ "$EUID" -ne 0 ]; then
                        log_info "Enabling APT hook requires root privileges."
                        sudo -v || { log_err "Sudo authorization failed."; exit 1; }
                    fi
                    install_apt_hook
                    log_ok "APT auto-update hook enabled at /etc/apt/apt.conf.d/99scripts."
                    ;;
                *)
                    log_err "Unknown target for enable: '$target' (available: apt)"
                    exit 1
                    ;;
            esac
            ;;
        disable)
            local target="${1:-apt}"
            case "$target" in
                apt)
                    if [ -f "/etc/apt/apt.conf.d/99scripts" ]; then
                        if [ "$EUID" -ne 0 ]; then
                            log_info "Disabling APT hook requires root privileges."
                            sudo -v || { log_err "Sudo authorization failed."; exit 1; }
                        fi
                        uninstall_apt_hook
                        log_ok "APT auto-update hook disabled (/etc/apt/apt.conf.d/99scripts removed)."
                    else
                        log_info "APT auto-update hook is already disabled."
                    fi
                    ;;
                *)
                    log_err "Unknown target for disable: '$target' (available: apt)"
                    exit 1
                    ;;
            esac
            ;;
        *)
            log_err "Unknown action: '$subcmd'"
            echo "Usage: scripts autoupdate [status|enable [apt]|disable [apt]]"
            exit 1
            ;;
    esac
}

# ------------------------------------------------------------------------------
# Main Dispatcher
# ------------------------------------------------------------------------------
show_help() {
    cat << EOF
Usage: scripts [COMMAND] [OPTIONS]

Unified manager for the nada.mu personal utilities ecosystem.

Commands:
  update       Sync and update utilities with repository (default: all)
  list         List all declared utilities and their current status
  autoupdate   Manage automated updates via package manager hooks (APT)
  uninstall    Remove installed utilities, man pages, and completions
  help         Display this help message

Options:
  --scope SCOPE        Target scope: 'user' (~/.local/bin) or 'system' (/usr/local/bin)
  --category CAT       Filter category: 'all', 'server', 'desktop', 'media'
  --method METHOD      Installation method: 'link' (default for repo) or 'copy'
  -y, --yes            Non-interactive mode; accept all defaults
  -h, --help           Show this help message

Examples:
  scripts update                          # Update all utilities (auto-scope, zero-prompt)
  scripts update --category server        # Update server utilities only
  sudo scripts update --scope system      # System-wide update in /usr/local/bin
  scripts autoupdate status               # Check automated update status
  scripts list                            # View available tools and statuses
EOF
}

ACTION="${1:-}"
[ $# -gt 0 ] && shift || true

case "$ACTION" in
    sync|update|install)
        # If in local git repo, pull first if possible
        if [ "$IS_LOCAL_REPO" = true ] && [ -d "$REPO_DIR/.git" ]; then
            log_head "Pulling latest changes from git repository..."
            git -C "$REPO_DIR" pull --ff-only || log_warn "Git pull failed or offline; proceeding with local files."
        fi
        cmd_sync "$@"
        ;;
    autoupdate)
        cmd_autoupdate "$@"
        ;;
    list)
        cmd_list "$@"
        ;;
    uninstall)
        cmd_uninstall "$@"
        ;;
    ""|-h|--help|help)
        show_help
        exit 0
        ;;
    *)
        log_err "Unknown command: '$ACTION'"
        show_help
        exit 1
        ;;
esac
